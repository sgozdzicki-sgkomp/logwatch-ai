# File managed by setup.sh. To change the configuration run: ./setup.sh --reconfigure
# Manual edits of values are preserved on updates (comments are regenerated).
# Values containing $ or spaces are wrapped in single quotes - this is how docker compose reads them.

# ======== General ========
# Time zone
TZ=Etc/UTC
# Application log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# How often (in seconds) to check Elasticsearch for new logs
POLL_INTERVAL_SECONDS=30

# ======== Elasticsearch (http without authentication by default) ========
# Protocol: http or https
ES_SCHEME=http
# IP address or hostname of the Elasticsearch server
ES_HOST=
# Elasticsearch port
ES_PORT=9200
# Username (empty = no authentication)
ES_USERNAME=
# Password
ES_PASSWORD=
# API key instead of username and password (takes precedence)
ES_API_KEY=
# Verify the TLS certificate (https only)
ES_VERIFY_CERTS=true
# Path to a CA certificate inside the container (optional)
ES_CA_CERT=
# Index or data stream pattern, e.g. logs-*,filebeat-*
ES_INDEX=*
# Event timestamp field
ES_TIMESTAMP_FIELD=@timestamp
# Extra query_string filter, e.g. NOT service.name:healthcheck
ES_EXTRA_QUERY=
# Size of a single read batch
ES_BATCH_SIZE=500
# Maximum number of batches per cycle
ES_MAX_BATCHES_PER_CYCLE=10
# Do not read the most recent seconds (indexing delay)
ES_INGEST_LAG_SECONDS=5
# How far back to read on the very first start
ES_INITIAL_LOOKBACK_MINUTES=15
# After a long outage, do not catch up further back than this many hours
ES_MAX_CATCHUP_HOURS=6
# Elasticsearch request timeout
ES_TIMEOUT_SECONDS=30
# Failed cycles in a row before a system notice is sent to Discord
ES_FAIL_NOTICE_AFTER=5

# ======== Ollama ========
# Protocol: http or https
OLLAMA_SCHEME=http
# IP address or hostname of the Ollama server
OLLAMA_HOST=
# Ollama port
OLLAMA_PORT=11434
# Model (must be pulled: ollama pull NAME)
OLLAMA_MODEL=qwen2.5:14b
# Model response timeout
OLLAMA_TIMEOUT_SECONDS=300
# Context window
OLLAMA_NUM_CTX=4096
# Temperature (low = stable verdicts)
OLLAMA_TEMPERATURE=0.1
# How long the model stays loaded in memory
OLLAMA_KEEP_ALIVE=10m
# Hard limit of Ollama requests per cycle
OLLAMA_MAX_CALLS_PER_CYCLE=8
# After this many seconds of analysis in a cycle, do not start new ones (log reading and alerts never wait for a slow Ollama)
OLLAMA_CYCLE_BUDGET_SECONDS=120
# When Ollama is unavailable, report critical+ entries as a preliminary alert
OLLAMA_FAIL_OPEN=true
# Language of the descriptions generated by the model
LANGUAGE=en
# Description of your environment for the model (improves verdict accuracy)
ENV_CONTEXT=

# ======== Discord ========
# Webhook URL (secret)
DISCORD_WEBHOOK_URL=
# Sender name
DISCORD_USERNAME='LogWatch AI'
# Mention added to 5/5 alerts, e.g. <@123456789> or <@&ROLE_ID> or @here
DISCORD_MENTION=
# The same pattern is not reported more often than every this many minutes
ALERT_COOLDOWN_MINUTES=60
# Global safety cap on alerts per hour
MAX_ALERTS_PER_HOUR=20

# ======== Filters and learning ========
# Below this level only keyword matches count: trace, debug, info, warn, error, critical
PREFILTER_MIN_LEVEL=warn
# Extra keywords, comma separated
PREFILTER_EXTRA_KEYWORDS=
# Minimum severity (1-5) at which an alert verdict is really an alert
ALERT_MIN_SEVERITY=4
# Ignoring requires at least this model confidence
IGNORE_MIN_CONFIDENCE=0.7
# Let the model propose regex rules (validated)
LEARN_REGEX_RULES=true
# Days after which an ignore verdict is re-evaluated
VERDICT_TTL_DAYS_IGNORE=14
# Days after which a watch verdict is re-evaluated
VERDICT_TTL_DAYS_WATCH=3
# Days after which an alert verdict is re-evaluated
VERDICT_TTL_DAYS_ALERT=7
# Frequency spike: minimum number of occurrences in one cycle
SPIKE_MIN_COUNT=50
# Frequency spike: multiple of the usual rate
SPIKE_FACTOR=5
# Days without occurrences after which a pattern is removed
FINGERPRINT_RETENTION_DAYS=60

# ======== Database ========
# sqlite, postgresql or mariadb
DB_TYPE=sqlite
# SQLite file path inside the container
SQLITE_PATH=/data/logwatch.sqlite3
# postgres or mariadb = database started in Docker; empty = SQLite or an external database
COMPOSE_PROFILES=
# Database host (for a database in Docker: postgres or mariadb)
DB_HOST=
# Database port (empty = default)
DB_PORT=
# Database name
DB_NAME=logwatch
# Database user
DB_USER=logwatch
# Database password (secret)
DB_PASSWORD=
# Optional full SQLAlchemy URL - overrides the settings above (secret)
DB_URL=
